{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuartzSSH",
  "version": "0.1.0",
  "identifier": "io.github.therealwh.quartzssh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuartzSSH",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight open-source SSH/SFTP client",
    "longDescription": "QuartzSSH is a lightweight, beautiful and fast open-source SSH/SFTP client for developers and system administrators.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Therealwh/QuartzSSH/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5RTE5REU5NkNEQjRFQTUKUldTbFR0dHM2WjNoV2NUb3dOdEUzYWhWYytqSjQzWlgwa1EwT2Rsak15RjlMQzRoS2MwZEIxVCsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
